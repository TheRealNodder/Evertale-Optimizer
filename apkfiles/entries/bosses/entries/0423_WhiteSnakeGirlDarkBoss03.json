    "passives": {
      "HitTargetPassiveAWhiteSnakeGirlDarkBoss": {
        "id": "HitTargetPassiveAWhiteSnakeGirlDarkBoss",
        "found": true,
        "localization": {
          "name": "Snake's Heart",
          "description": "This unit cannot be defeated by damage from Poison status effects, and cannot be sent to the reinforcements from the battlefield.\n\nThis unit has 50% damage reduction from attacks, and reduces the amount of any stun effects against the unit by 50TU.\n\nThis unit's attacks heal this unit for 1% of total damage dealt, ignore damage reduction effects, and any effects of non-boss enemies that would prevent targets from being defeated.\n\nEach time this unit damages any number of non-conjured units with an attack, this unit will immediately get the next turn. If this triggers 3 times within 50TU, this effect cannot trigger again until 50TU advances. This effect can trigger again against the same unit. Effects that influence TU order may interrupt the extra turn (e.g. Stuns targeting the lowest TU target)."
        }
      },
      "BecomeDeathPassiveAWhiteSnakeGirlDarkBoss": {
        "id": "BecomeDeathPassiveAWhiteSnakeGirlDarkBoss",
        "found": true,
        "localization": {
          "name": "Snake's Vigor",
          "description": "This unit enters battle with Super Stealth.\n\nIf this unit would be defeated by an enemy attack or a status effect while having more than 1 HP, it instead survives with 1 HP.\n\nEach time this unit takes damage from an attack and survives until after the end of the turn, this unit will be Purified."
        }
      }
