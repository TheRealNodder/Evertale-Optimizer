    "passives": {
      "PassPassiveAArsenalRegularBoss": {
        "id": "PassPassiveAArsenalRegularBoss",
        "found": true,
        "localization": {
          "name": "Ultimate Scion",
          "description": "This unit cannot be sent to the reinforcements from the battlefield, and cannot be defeated by damage from Poison or Burn status effects.\n\nThis unit cannot be stunned if there is another Storm unit (ally or enemy) on the battlefield. This unit cannot fall asleep if there are any Water units (ally or enemy) on the battlefield.\n\nThis unit's attacks heal this unit for 1% of total damage dealt, and ignore any effects of non-boss enemies that would prevent targets from being defeated.\n\nIf this unit has a Charge, when this unit uses Bolt Blast or Charged Blade, this unit will consume 1 Charge to have its current TU reduced by 30TU. If this triggers 3 times within 10TU, this effect cannot trigger again until 50TU advances."
        }
      },
      "KickToTheHeadPassiveAArsenalRegularBoss": {
        "id": "KickToTheHeadPassiveAArsenalRegularBoss",
        "found": true,
        "localization": {
          "name": "Bring the Thunder",
          "description": "If this unit would be defeated by an enemy attack or a status effect while having more than 1 HP, it instead survives with 1 HP.\n\nEach time this unit takes damage from an attack and survives until after the end of the turn, this unit will gain a Charge. If this unit already had 3 Charges stored, this unit then consumes 2 Charges to have its current TU reduced to 0. This TU reduction may trigger before or after other effects that adjust the turn order. Certain skills are affected by and may consume charges. A unit can store a maximum of 3 charges.\n\nAfter the end of each of this unit's turns, if less than 2 enemies on the battlefield have their Active Skills disabled, this unit will disable 1 random enemy's Active Skills for 50TU. This unit can only successfully trigger this effect 5 times since entering the battlefield. This effect cannot trigger if Arsenal has no other allies on the battlefield."
        }
      }
