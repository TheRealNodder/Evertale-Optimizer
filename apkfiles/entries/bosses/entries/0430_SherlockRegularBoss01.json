    "passives": {
      "GameIsAFootPassiveASherlockRegularBoss": {
        "id": "GameIsAFootPassiveASherlockRegularBoss",
        "found": true,
        "localization": {
          "name": "Grand Detective",
          "description": "This unit cannot fall asleep or be sent to the reinforcements from the battlefield.\n\nThis unit's attacks ignore damage reduction effects, and any effects of non-boss enemies that would prevent targets from being defeated.\n\nThis unit has 20% damage reduction from attacks for each Charge stored on this unit (max of 60% while 3 Charges are stored on this unit).\n\nWhenever this unit gains a Charge from one of its own active skills, 1 random enemy's Active Skills are disabled for 50TU. This effect cannot trigger from a Charge gained while this unit already has 3 Charges stored."
        }
      },
      "TrueDetectivePassiveASherlockRegularBoss": {
        "id": "TrueDetectivePassiveASherlockRegularBoss",
        "found": true,
        "localization": {
          "name": "Londinium's Finest",
          "description": "This unit cannot be poisoned for 100TU.\n\nIf this unit would be defeated by an enemy attack or a status effect while having more than 1 HP, it instead survives with 1 HP.\n\nEach time this unit takes damage from an attack and survives until after the end of the turn, this unit will be Purified.\n\nAfter the end of each other ally's turn, this unit will have its TU reduced to 0. This TU reduction may trigger before or after other effects that adjust the turn order. Then this effect cannot trigger again until 50TU advances.\n\nWhen this unit takes damage from an attack, they will immediately get the next turn, this cannot trigger again until TU advances. This is a skin effect. This unit cannot become a Guardian or Stun Absorber."
        }
      }
    },
