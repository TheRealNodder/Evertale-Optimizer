    "passives": {
      "StakeInHandPassiveVanHelsingRegularBoss": {
        "id": "StakeInHandPassiveVanHelsingRegularBoss",
        "found": true,
        "localization": {
          "name": "Twilight Hunter",
          "description": "This unit cannot be sent to the reinforcements from the battlefield.\n\nThis unit's attacks ignore damage reduction effects, and any effects of non-boss enemies that would prevent targets from being defeated.\n\nThis unit will gain a Charge each time another ally gets the turn. Certain skills are affected by and may consume charges. A unit can store a maximum of 3 charges, and all charges are removed from a unit that leaves the battlefield.\n\nWhen this unit enters battle, this unit grants all allies Sleep Immunity, Poison Immunity, and Stun Immunity until the end of their next turn while on the battlefield.\n\nWhen this unit defeats an enemy with an attack, if they are:\n- Dark or Storm, after the end of the turn, all allies on the battlefield, will be given the next turns by reducing their current TU. These TU reductions may trigger before or after other effects that adjust the turn order.\n- Light or Earth, all allies on the battlefield will have the TU costs for all of their skills reduced by 20%. This will overwrite the effects of other Quicken skills.\n- Water or Fire, all allies on the battlefield will be Purified (any negative status effects like sleep, burn or poison are removed).\nAll of these defeat effects may trigger before or after other effects."
        }
      },
      "PreparedPassiveVanHelsingRegularBoss": {
        "id": "PreparedPassiveVanHelsingRegularBoss",
        "found": true,
        "localization": {
          "name": "Wooden Stake",
          "description": "If this unit would be defeated by an enemy attack or a status effect while having more than 1 HP, it instead survives with 1 HP.\n\nThis unit has 35% damage reduction from attacks for 100TU. Afterwards this unit has 70% damage reduction instead.\n\nAfter entering battle, for 100TU, each time this unit takes damage from an attack and survives until after the end of the turn, this unit will be Purified, and have its TU reduced to 0. This TU reduction may trigger before or after other effects that adjust the turn order.\n\nAt the end of the first turn this unit gets on the battlefield, this unit is granted Sleep Immunity for 50TU, Stun Immunity for 50TU, and Poison Immunity for 50TU."
        }
      }
