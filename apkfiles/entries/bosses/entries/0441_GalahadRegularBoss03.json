      "SpecialBuffAGalahadRegularBoss": {
        "id": "SpecialBuffAGalahadRegularBoss",
        "found": true,
        "localization": {
          "name": "Shield Fort",
          "description": "Removes poison (including Lethal Poison), and burn (including Mega Healing Burn) from all allies on the battlefield.\n\nThen all non-Fortified allies on the battlefield are Fortified.\n\nUsable only if the user is not alone, and not Fortified. Usable 3 times per battle. A Fortified unit has 50% damage reduction from attacks. This reduction cannot be ignored by attacks that do not specifically ignore Fortify. Fortify will be removed after reducing damage 3 times since applying, and will be reset if reapplied. This is not a status effect.",
          "selected": "Removes Poison & Burn, Fortifies"
        },
        "ability": {
