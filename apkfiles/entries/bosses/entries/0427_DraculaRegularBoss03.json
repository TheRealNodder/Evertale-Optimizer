        "found": true,
        "localization": {
          "name": "Ruler of Vampires",
          "description": "This unit has 50% damage reduction from attacks.\n\nThis unit cannot be sent to the reinforcements from the battlefield.\n\nThis unit cannot be defeated by damage from Poison status effects.\n\nThis unit's attacks ignore damage reduction effects, Counter Stance Status Effects, and the effects of Skin passive skills.\n\nWhenever another unit (ally or enemy) on the battlefield damages any unit(s) with an attack, this unit's current TU is reduced by 30TU per unit hit. When this unit gets the turn, unless this unit is sleeping, this effect cannot trigger until 30TU advances."
        }
      },
      "TransylvaniaPassiveADraculaRegularBoss": {
        "id": "TransylvaniaPassiveADraculaRegularBoss",
        "found": true,
        "localization": {
          "name": "Timeless Blood",
          "description": "If this unit would be defeated by an enemy attack or a status effect while having more than 1 HP, it instead survives with 1 HP.\n\nThis unit enters battle with a Stun Ward.\n\nWhile this unit is on the battlefield, the first time another non-conjured unit on the battlefield is defeated or sacrificed by any source:\n- this unit will be Purified (any negative status effects like sleep, burn or poison are removed).\n- this unit will have its TU reduced to 0."
        }
      }
