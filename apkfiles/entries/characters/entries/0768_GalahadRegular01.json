    "passives": {
      "GreatestKnightPassiveAGalahadRegular": {
        "id": "GreatestKnightPassiveAGalahadRegular",
        "found": true,
        "localization": {
          "name": "Shield of Camelot",
          "description": "This unit is a Guardian. For any enemy attack that would hit 1 or 2 other allies, this unit has a 100% chance to redirect 1 hit to itself instead. This unit will not redirect skills that don't deal damage.\n\nThis unit cannot be sent to the reinforcements from the battlefield.\n\nAfter entering battle, this unit cannot be slept or poisoned for 50TU.\n\nEach time this unit takes damage from an attack while not burning and survives until after the end of the turn, a random non-Guardian ally will have their current TU reduced by 50TU. This is not a skin effect. This TU reduction may trigger before or after other effects that adjust the turn order.\n\nUnless this unit is burning, this unit cannot:\n- Be stunned\n- Become hypnotized\n- Be immediately defeated without damage by a non-boss enemy."
        }
      },
      "RoundTablePassiveAGalahadRegular": {
        "id": "RoundTablePassiveAGalahadRegular",
        "found": true,
        "localization": {
          "name": "The Silent Knight",
          "description": "When this unit enters battle:\n- all allies are Fortified.\n- this unit will Endure the next damage that would defeat it with 1HP. Endure effects cannot stack.\n- all enemies will be granted Rage Wards. Rage Wards will prevent a unit from becoming Enraged once, then be removed. Rage Wards cannot stack.\n\nAfter this unit's first turn on the battlefield, all allies on the battlefield are healed for 100% of max HP, and Fortified.\n\nIf this unit takes damage from an attack and survives until after the end of the turn, a random ally that has their Active Skills disabled will have any enemy effects that are currently disabling their Active Skills end. This cannot end Time Stop effects. Then this unit will heal for 25% of max HP. This healing is increased to 100% of max HP for the first 3 times it triggers while this unit is on the battlefield."
        }
      },
